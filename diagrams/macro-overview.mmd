flowchart LR

    USER(["👤 User<br/>(optional)"]) -->|"Taps UI Extension"| MACRO

    subgraph MACRO["Macro"]
        direction LR

        

        subgraph MACRO_INIT_SUB["Initialization Function"]
            direction LR
            MACRO_INIT_WEBENGINE(["Enable WebEngine & <br/>AllowDeviceCertificate"])
            MACRO_INIT_PANEL(["Save UI Extension Panel<br/>(Optional)"])
            MACRO_INIT_SYNC(["Trigger Sync"])
            MACRO_INIT_WEBENGINE -->MACRO_INIT_PANEL
            MACRO_INIT_PANEL -->MACRO_INIT_SYNC
        end

        subgraph WIDGET_CLICKED_SUB["Process Widget Events Function (optional)"]
            direction LR
            WIDGET_CLICKED(["Widget Clicked"])
            VALID_WIDGET_ID{"Valid<br>Widget ID"}
            WIDGET_SYNC(["Trigger Sync"])
            WIDGET_IGNORE(["Ignore Event"])
            WIDGET_CLICKED --> VALID_WIDGET_ID
            VALID_WIDGET_ID -->|"Yes"| WIDGET_SYNC
            VALID_WIDGET_ID -->|"No"| WIDGET_IGNORE
        end


        subgraph SUBSCRIBED_SUB["xStatus & xConfig Subscriptions Monitor"]
            direction LR
            SUBSCRIBED_PWA_URL(["PWA Web App<br/>URL xConfig"])
            SUBSCRIBED_IP_ADDRESS(["IPv4/6 Address<br/>xStatuses"]) 
            SUBSCRIBED_SCHEDULE_SYNC["Schedule Synce<br/>(debounded)"]
            SUBSCRIBED_SYNC(["Trigger Sync"])
            SUBSCRIBED_PWA_URL --> SUBSCRIBED_SCHEDULE_SYNC
            SUBSCRIBED_IP_ADDRESS --> SUBSCRIBED_SCHEDULE_SYNC
            SUBSCRIBED_SCHEDULE_SYNC --> SUBSCRIBED_SYNC
        end


        subgraph SYNC_URL["Sync URL Function"]
            direction TB
            GET_ADDRESS["Get Addresses"]
            GET_PWA_URL["Get PWA URL Hash"]
            GET_ACCOUNT_DETAILS["Get Local<br/>Account Details"]
            GET_ADDITIONAL_PARAMETERS["Get Stored/Updated Parameters"]
            UP_TO_DATE{"PWA URL<br/>Requires Update?"}
            UPDATE_URL("Update PWA URL Hash")
            DONT_UPDATE_URL("Don't Update URL Hash")
            GET_ADDRESS --> GET_PWA_URL
            GET_PWA_URL --> GET_ACCOUNT_DETAILS
            GET_ACCOUNT_DETAILS --> GET_ADDITIONAL_PARAMETERS
            GET_ADDITIONAL_PARAMETERS --> UP_TO_DATE
            UP_TO_DATE --> |"No"| DONT_UPDATE_URL
            UP_TO_DATE --> |"Yes"| UPDATE_URL
        end

       

        SUBSCRIBED_SUB -->|"Tigger Sync"| SYNC_URL
        WIDGET_CLICKED_SUB -->|"Tigger Sync<br/>(parameter change)"| SYNC_URL
        MACRO_INIT_SUB -->|"Tigger Sync"| SYNC_URL



    end

    WIDGET_CLICKED@{ shape: manual-input}
    SUBSCRIBED_SCHEDULE_SYNC@{ shape: delay}
    
