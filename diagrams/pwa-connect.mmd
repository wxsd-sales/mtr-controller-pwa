flowchart LR

    HASH_OK(["Hash parameters valid"]) --> CONNECTING
    CONNECTING["view-connecting<br/>Connecting to address"]
    CONN_RESULT{"Connection<br/>result"}
    CONN_FAILED(["Show error<br/>(error / closed)"])
    RETRY(["Wait, then retry"])
    READY(["Connected:<br/>query & subscribe xStatus"])

    CONNECTING --> CONN_RESULT
    CONN_RESULT -->|"Error / close"| CONN_FAILED
    CONN_FAILED --> RETRY
    RETRY --> CONNECTING
    CONN_RESULT -->|"Ready"| READY

